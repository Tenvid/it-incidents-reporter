# Copy this file to .env and adjust values per environment (e.g. Docker
# service hostnames). Both Django (src/incidents_reporter/settings.py) and
# the Flask operability-check service (networking/app.py) read from it.

# Flask operability-check service
API_HOST=0.0.0.0
API_PORT=5001
ALLOWED_ORIGIN=http://localhost:8000

# Django — base URL the browser uses to reach the Flask service
INCIDENT_API_URL=http://localhost:5001
